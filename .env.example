SUWAPPU_API_KEY=suwappu_sk_your_api_key_here

# Only required for managed execution. The wallet is bound to the quote and simulation.
SUWAPPU_WALLET_ADDRESS=0x_your_managed_wallet_address

# start/run-once remain preview-only unless this is exactly 1 AND --execute is passed.
SUWAPPU_ALLOW_MANAGED_EXECUTION=0

# Optional development endpoint override.
# SUWAPPU_API_URL=https://api.suwappu.bot
