{
  "name": "suwappu-dca-bot",
  "version": "2.0.0",
  "description": "Standalone fixed-USDC recurring-action product reference with outcome-safe Suwappu execution",
  "type": "module",
  "bin": {
    "suwappu-dca": "src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts start",
    "status": "bun src/index.ts status",
    "history": "bun src/index.ts history",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "verify": "bun run typecheck && bun test && bun run build && bun audit --audit-level=high"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xSoftBoi/suwappu-dca-bot"
  },
  "homepage": "https://github.com/0xSoftBoi/suwappu-dca-bot#readme",
  "keywords": ["suwappu", "dca", "dollar-cost-averaging", "defi", "trading", "bot"],
  "author": "Suwappu",
  "dependencies": {
    "chalk": "5.6.2",
    "commander": "12.1.0",
    "node-cron": "4.6.0",
    "ora": "8.2.0"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  },
  "engines": { "bun": ">=1.3.14" },
  "packageManager": "bun@1.3.14",
  "license": "MIT"
}
